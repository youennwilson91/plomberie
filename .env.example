# Copie ce fichier en .env pour le dev local, et renseigne les mêmes variables
# dans les settings de l'hébergeur (Railway…) pour la prod.
#
# Envoi des demandes du formulaire de contact via l'API HTTP de Resend.
# On n'utilise pas SMTP : Railway bloque les ports SMTP sortants.
#
# Mise en place SANS domaine vérifié :
#   1. Créer le compte Resend avec l'adresse e-mail de l'agence.
#   2. Créer une clé API (Sending access) → RESEND_API_KEY.
#   3. Laisser RESEND_FROM_EMAIL vide (défaut onboarding@resend.dev) et mettre
#      CONTACT_EMAIL = l'adresse du compte Resend (tant qu'aucun domaine n'est
#      vérifié, Resend n'autorise l'envoi qu'à cette adresse).
# Limite du mode sans domaine : 100 e-mails/jour, destinataire = compte Resend.

# Clé API Resend — OBLIGATOIRE pour que le formulaire envoie quoi que ce soit.
RESEND_API_KEY=

# Destinataire des demandes. Sans domaine vérifié : l'adresse du compte Resend.
CONTACT_EMAIL=

# Expéditeur. Vide = onboarding@resend.dev. À passer sur une adresse du domaine
# (ex. contact@aps-plomberie.fr) seulement une fois le domaine vérifié chez Resend.
RESEND_FROM_EMAIL=
